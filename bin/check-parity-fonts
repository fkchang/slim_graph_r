#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
if ! command -v node >/dev/null || ! command -v npm >/dev/null; then
  echo "Parity font check needs Node.js and a global Playwright installation." >&2
  exit 1
fi

global_node_modules="$(npm root -g)"
NODE_PATH="$global_node_modules${NODE_PATH:+:$NODE_PATH}" node "$root/script/check_parity_fonts.js"
